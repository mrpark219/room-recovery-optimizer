@baseUrl = http://localhost:8080

### 숙소 조회 (이전 실행의 ID 초기화)
GET {{baseUrl}}/api/accommodations

> {%
    client.global.clear("outage1");
    client.global.clear("outage2");
    client.test("숙소 조회 성공", function () { client.assert(response.status === 200); });
%}

### 객실 조회
GET {{baseUrl}}/api/accommodations/1/rooms

> {%
    client.test("객실 조회 성공", function () { client.assert(response.status === 200); });
%}

### 101호 이용 불가 생성 (종료일은 숙박에 미포함)
POST {{baseUrl}}/api/accommodations/1/unavailabilities
Content-Type: application/json

{"roomId":1,"startDate":"2026-11-11","endDate":"2026-11-13","reason":"설비 점검"}

> {%
    client.test("101호 이용 불가 생성", function () {
        client.assert(response.status === 201 && response.body.id != null, "생성 실패: 응답을 확인하세요");
        client.global.set("outage1", String(response.body.id));
    });
%}

### 102호 이용 불가 생성
POST {{baseUrl}}/api/accommodations/1/unavailabilities
Content-Type: application/json

{"roomId":2,"startDate":"2026-11-11","endDate":"2026-11-13","reason":"누수 점검"}

> {%
    client.test("102호 이용 불가 생성", function () {
        client.assert(response.status === 201 && response.body.id != null, "생성 실패: 응답을 확인하세요");
        client.global.set("outage2", String(response.body.id));
    });
%}

### 이용 불가 목록
GET {{baseUrl}}/api/accommodations/1/unavailabilities

> {%
    client.test("목록 조회 성공", function () { client.assert(response.status === 200); });
%}

### 생성한 이용 불가 상세
GET {{baseUrl}}/api/accommodations/1/unavailabilities/{{outage1}}

> {%
    client.test("상세 조회 성공", function () { client.assert(response.status === 200 && String(response.body.id) === client.global.get("outage1")); });
%}

### 객실과 날짜는 그대로 두고 사유 변경
PUT {{baseUrl}}/api/accommodations/1/unavailabilities/{{outage1}}
Content-Type: application/json

{"roomId":1,"startDate":"2026-11-11","endDate":"2026-11-13","reason":"설비 점검 완료 예정"}

> {%
    client.test("사유 변경 성공", function () { client.assert(response.status === 200 && response.body.reason === "설비 점검 완료 예정"); });
%}

### 복구 계산: 초기 demo 데이터 기준 예상 결과
POST {{baseUrl}}/api/accommodations/1/recovery-calculations
Content-Type: application/json

{"referenceDate":"2026-11-11"}

> {%
    client.test("복구 계산 결과", function () {
        client.assert(response.status === 200, "복구 계산 실패");
        var body = response.body;
        var affected = body.affectedReservations.map(function (r) { return r.reservationId; }).sort();
        client.assert(JSON.stringify(affected) === JSON.stringify([1, 2]), "영향 예약은 1, 2여야 합니다");
        client.assert(JSON.stringify(body.urgentReservationIds) === JSON.stringify([1]), "긴급 예약은 1이어야 합니다");
        client.assert(body.placements.length === 1 && body.placements[0].reservationId === 1 && body.placements[0].segments.some(function (s) { return s.roomId === 3; }), "예약 1은 201호로 배정되어야 합니다");
        client.assert(body.estimatedAdditionalCost === 50000, "추가 비용은 50,000원이어야 합니다");
        client.assert(JSON.stringify(body.unresolvedReservationIds) === JSON.stringify([2]), "미해결 예약은 2여야 합니다");
    });
%}

### 정리: 101호 이용 불가 삭제
DELETE {{baseUrl}}/api/accommodations/1/unavailabilities/{{outage1}}

> {%
    client.test("101호 삭제 성공", function () { client.assert(response.status === 204, "삭제 실패: 생성 ID와 응답을 확인하세요"); client.global.clear("outage1"); });
%}

### 정리: 102호 이용 불가 삭제
DELETE {{baseUrl}}/api/accommodations/1/unavailabilities/{{outage2}}

> {%
    client.test("102호 삭제 성공", function () { client.assert(response.status === 204, "삭제 실패: 생성 ID와 응답을 확인하세요"); client.global.clear("outage2"); });
%}
